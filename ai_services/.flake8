[flake8]
max-line-length = 160
exclude = venv, __pycache__, cache, .pytest_cache
extend-ignore = E203, W503, E402, F401, F841, E501, W291, W293, E301, E302, E303, E305, E201, E202, E261, E127, E131, E251, E306, E741, W391, F811, F541, E231
per-file-ignores =
    __init__.py: F401
count = True
statistics = True
