# ==============================================================================
# FrontWing Backend Service - Environment Variables Reference
# ==============================================================================

# Port the Express HTTP & WebSocket server binds to
# Default: 5000
PORT=5000

# Runtime environment ('production' or 'development')
# In production: strict CORS origin verification is enforced and internal 500 stack traces are masked.
NODE_ENV=production

# PostgreSQL Database Connection String
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]
# In Docker: postgresql://postgres:postgres@postgres:5432/frontwing
# Local Dev: postgresql://postgres:postgres@localhost:5433/frontwing
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/frontwing

# Redis Connection URL
# Format: redis://[HOST]:[PORT]/[DB_INDEX]
# In Docker: redis://redis:6379/0
# Local Dev: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# FastF1 / LangGraph AI Services Gateway Base URL
# In Docker: http://ai_services:8000
# Local Dev: http://localhost:8000
AI_SERVICE_URL=http://ai_services:8000

# JSON Web Token (JWT) Signature Secret
# REQUIRED: Must be a cryptographically secure random string with minimum 32 characters.
# Generate via: openssl rand -hex 32
JWT_SECRET=f1_frontwing_super_secret_jwt_key_2026_telemetry_secure

# JWT Token Expiry Duration
# Format: e.g. "7d", "24h", "60m"
JWT_EXPIRES_IN=7d

# Logging Verbosity Level ('info', 'debug', 'warn', 'error')
LOG_LEVEL=info

# Comma-Separated Whitelist of Allowed CORS Origins for Browser Clients
# In production: must list explicit allowed origins. Wildcards (*) are rejected.
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1
