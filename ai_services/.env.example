# ==============================================================================
# FrontWing AI Services (FastAPI / FastF1 / LangGraph) - Environment Reference
# ==============================================================================

# Runtime Environment ('production' or 'development')
# In production: Swagger /docs and OpenAPI schemas are disabled, and 500 error details are masked.
ENVIRONMENT=production

# Server Port (Default: 8000)
PORT=8000

# Logging Level ('INFO', 'DEBUG', 'WARNING', 'ERROR')
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# LLM Providers & API Keys
# ------------------------------------------------------------------------------

# Active LLM Provider ('gemini' or 'groq')
MODEL_PROVIDER=gemini

# Primary Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Target Gemini Model Identifier
GEMINI_MODEL=gemini-3.6-flash

# Secondary / Fallback Groq Cloud API Key
# Obtain from Groq Cloud Console: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Target Groq Model Identifier
GROQ_MODEL=openai/gpt-oss-120b

# Enable Redis Caching for LLM Responses and Intent Classifications
LLM_CACHE_ENABLED=true

# ------------------------------------------------------------------------------
# Database & Cache Connections
# ------------------------------------------------------------------------------

# PostgreSQL Connection String
# In Docker: postgresql://postgres:postgres@postgres:5432/frontwing
# Local Dev: postgresql://postgres:postgres@localhost:5433/frontwing
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/frontwing

# Redis Connection URL
# In Docker: redis://redis:6379/0
# Local Dev: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# External Telemetry & Schedule Data Endpoints
# ------------------------------------------------------------------------------

# OpenF1 Telemetry REST API Base URL
OPENF1_BASE_URL=https://api.openf1.org/v1

# Ergast API Base URL (Legacy Fallback)
ERGAST_BASE_URL=https://ergast.com/api/f1

# ------------------------------------------------------------------------------
# LangSmith Observability & Agent Tracing (Optional)
# ------------------------------------------------------------------------------

LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=FrontWing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=FrontWing
