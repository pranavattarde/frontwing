# ==============================================================================
# FrontWing Frontend Client - Environment Variables Reference
# ==============================================================================

# Backend API Gateway Base URL
# In Docker/Production with Nginx Reverse Proxy:
# Leave blank ("") or omitted to use relative paths (/api, /engineer, /strategy)
# handled directly by Nginx.
#
# In Local Development:
# Set to the Express backend port: http://localhost:5000
VITE_API_URL=http://localhost:5000
